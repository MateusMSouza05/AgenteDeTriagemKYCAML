# Copy to .env and fill in. Never commit .env.
# Gemini through Vertex AI (no API key; uses Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=projeto-vertice-auditores
GOOGLE_CLOUD_LOCATION=global

# BigQuery / GCS
KYC_BQ_LOCATION=southamerica-east1
KYC_BUCKET=vertice-kyc-projeto-vertice-auditores

# 1 = read data/*.csv and data/gcs/ instead of BigQuery/GCS (offline fallback)
KYC_LOCAL=0

# Gemini model used by the agent (GA model; the report itself never depends on it)
KYC_MODELO=gemini-2.5-flash
