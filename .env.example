# Copie para .env e preencha. Nunca faça commit do .env.
# Gemini via Vertex AI (sem chave de API; usa Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# BigQuery / GCS
KYC_BQ_LOCATION=
KYC_BUCKET=

# 1 = lê data/*.csv e data/gcs/ no lugar de BigQuery/GCS (modo offline de reserva)
KYC_LOCAL=0

# Modelo Gemini do agente (versão GA; o parecer em si nunca depende dele)
KYC_MODELO=gemini-2.5-flash
